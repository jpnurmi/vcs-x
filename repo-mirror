#!/bin/bash

set -e

lfs=
sync=
repo_mirror_location=${REPO_MIRROR_LOCATION:-$PWD}

function usage() {
    echo "Usage: $(basename $0) [options]"
    echo ""
    echo "Runs 'repo-sync' and 'repo-lfs-fetch' in \$REPO_MIRROR_LOCATION (or"
    echo "\$PWD if not set). Furthermore, if no '.repo' directory is found, runs"
    echo "'repo-init --mirror' to set up a new mirror."
    echo ""
    echo "Options:"
    echo "-h,--help"
    echo "-j,--jobs <jobs>"
    echo "--sync"
    echo "--lfs"
    exit $1
}

opts=()
for opt in "$@"; do
    case "$opt" in
        -h|--help)
            usage
            ;;
        --sync)
            sync=true
            shift
            ;;
        --lfs)
            lfs=true
            shift
            ;;
        *)
            opts+=("$opt")
            ;;
    esac
done

if [ ! -d "$repo_mirror_location/.repo" ]; then
    mkdir -p "$repo_mirror_location"
    cd "$repo_mirror_location"
    repo-init --mirror
else
    cd "$repo_mirror_location"
fi

if [ -z "$sync" ] && [ -z "$lfs" ]; then
    sync=true
    lfs=true
elif [ -z "$sync" ]; then
    [ -z "$lfs" ] && sync=true || sync=false
elif [ -z "$lfs" ]; then
    [ -z "$sync" ] && lfs=true || lfs=false
fi

if [ $sync = true ]; then
    echo "Syncing $repo_mirror_location..."
    repo-sync "${opts[@]}"
fi

if [ $lfs = true ]; then
    echo "Fetching LFS $repo_mirror_location..."
    repo-lfs-fetch "${opts[@]}"
fi
